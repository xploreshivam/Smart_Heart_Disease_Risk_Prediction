<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prediction Report - CardioPulse</title>

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- CSS -->
    <link rel="stylesheet" href="/static/css/style.css">
</head>

<body>

<!-- Animated Background -->
<div class="bg-animation">
    <div class="blob blob1"></div>
    <div class="blob blob2"></div>
    <div class="blob blob3"></div>
    <div class="blob blob4"></div>
</div>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark custom-navbar">
    <div class="container">
        <a class="navbar-brand logo d-flex align-items-center gap-2" href="/">
            <div class="logo-icon-box">
                <i class="bi bi-activity"></i>
            </div>
            <span class="brand-text">CardioPulse</span>
        </a>

        <div class="d-flex align-items-center gap-3">
            <!-- Language Selection Dropdown -->
            <div class="dropdown lang-dropdown">
                <button class="lang-dropdown-btn d-flex align-items-center gap-2" type="button" id="langDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-globe2 text-cyan"></i>
                    <span class="lang-code-badge" id="current-lang-code">EN</span>
                    <span class="lang-text" id="current-lang-text">English</span>
                    <i class="bi bi-chevron-down ms-1 chevron-icon"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end lang-dropdown-menu" aria-labelledby="langDropdown">
                    <li>
                        <button class="dropdown-item lang-option active" type="button" data-lang="en">
                            <span class="lang-code-pill">EN</span>
                            <span class="option-name">English</span>
                            <i class="bi bi-check2 check-icon ms-auto"></i>
                        </button>
                    </li>
                    <li>
                        <button class="dropdown-item lang-option" type="button" data-lang="hi">
                            <span class="lang-code-pill">HI</span>
                            <span class="option-name">हिन्दी (Hindi)</span>
                            <i class="bi bi-check2 check-icon ms-auto"></i>
                        </button>
                    </li>
                    <li>
                        <button class="dropdown-item lang-option" type="button" data-lang="hn">
                            <span class="lang-code-pill">HN</span>
                            <span class="option-name">Hinglish</span>
                            <i class="bi bi-check2 check-icon ms-auto"></i>
                        </button>
                    </li>
                </ul>
            </div>

            <a href="/" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i>
                <span data-i18n="res_btn_new">New Prediction</span>
            </a>
        </div>
    </div>
</nav>

<!-- Result Section -->
<section class="result-section">
    <div class="container">
        <div class="glass-card result-card" id="printable-report">
            <div class="text-center">
                <div class="badge-ai-pill d-inline-flex mx-auto mb-2">
                    <span class="badge-ai-dot"></span>
                    <span data-i18n="res_badge">AI Risk Assessment Result</span>
                </div>
                <h1 data-i18n="res_title">Cardiovascular Health Report</h1>
                <p class="text-white-50" data-i18n="res_subtitle">Generated using AI Clinical Risk Stratification Engine</p>
            </div>

            <hr class="border-secondary opacity-25 my-4">

            <div class="row align-items-center g-4">
                <!-- LEFT: GAUGE -->
                <div class="col-lg-5 text-center">
                    <div class="risk-circle">
                        <div class="outer-circle">
                            <div class="inner-circle">
                                <h1 id="counter">0%</h1>
                                <p data-i18n="res_gauge_label">Risk Score</p>
                            </div>
                        </div>
                    </div>

                    <h3 class="risk-level mt-3" data-i18n="<%= levelKey || 'level_low' %>"><%= level %></h3>
                </div>

                <!-- RIGHT: PREDICTION & PATIENT SUMMARY -->
                <div class="col-lg-7">
                    <div class="prediction-box">
                        <% if (prediction === "Heart Disease Detected") { %>
                        <div class="prediction-icon danger">
                            <i class="bi bi-heart-pulse-fill"></i>
                        </div>
                        <% } else { %>
                        <div class="prediction-icon success">
                            <i class="bi bi-heart-fill"></i>
                        </div>
                        <% } %>

                        <div>
                            <h5 data-i18n="res_outcome_title">Prediction Outcome</h5>
                            <h2 class="prediction-outcome-text" data-i18n="<%= predictionKey || 'out_not_detected' %>"><%= prediction %></h2>
                        </div>
                    </div>

                    <br>

                    <div class="patient-card">
                        <h4>
                            <i class="bi bi-person-circle text-cyan"></i>
                            <span data-i18n="res_patient_details">Patient Summary</span>
                        </h4>

                        <table class="table table-borderless">
                            <tbody>
                                <tr>
                                    <td class="text-white-50" data-i18n="label_name">Patient Name</td>
                                    <td><strong><%= name %></strong></td>
                                </tr>
                                <tr>
                                    <td class="text-white-50" data-i18n="res_probability_label">AI Probability / Risk</td>
                                    <td><strong><%= risk %> %</strong></td>
                                </tr>
                                <tr>
                                    <td class="text-white-50" data-i18n="res_category_label">Risk Category</td>
                                    <td>
                                        <span class="risk-badge" data-i18n="<%= levelKey || 'level_low' %>">
                                            <%= level %>
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <br>

                    <div class="ai-card">
                        <h4>
                            <i class="bi bi-cpu-fill text-cyan"></i>
                            <span data-i18n="res_ai_analysis_title">AI Clinical Analysis</span>
                        </h4>
                        <p class="text-white-50 mb-0" data-i18n="res_ai_analysis_desc">
                            The prediction has been computed using a trained Random Forest cardiovascular risk assessment engine. 
                            The risk percentage represents calibrated disease probability based on 16 clinical factors including resting BP, cholesterol levels, ECG dynamics, exercise ST depression, and lifestyle metrics.
                        </p>
                    </div>
                </div>
            </div>

            <hr class="border-secondary opacity-25 my-5">

            <!-- Clinical Indicators and Lifestyle Recommendations -->
            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="glass-small h-100">
                        <h4 class="d-flex align-items-center gap-2">
                            <i class="bi bi-bar-chart-fill text-cyan"></i>
                            <span data-i18n="res_indicators_title">Key Clinical Indicators</span>
                        </h4>

                        <div class="factor">
                            <div class="d-flex justify-content-between mb-1">
                                <span data-i18n="label_bp">Resting Blood Pressure</span>
                                <small class="text-white-50"><%= bpValue %> mmHg</small>
                            </div>
                            <div class="progress">
                                <div class="progress-bar <%= bpScore > 70 ? 'bg-danger' : (bpScore > 40 ? 'bg-warning' : 'bg-success') %>"
                                    style="width: <%= bpScore %>%">
                                </div>
                            </div>
                        </div>

                        <div class="factor">
                            <div class="d-flex justify-content-between mb-1">
                                <span data-i18n="label_chol">Serum Cholesterol</span>
                                <small class="text-white-50"><%= cholValue %> mg/dL</small>
                            </div>
                            <div class="progress">
                                <div class="progress-bar <%= cholScore > 70 ? 'bg-danger' : (cholScore > 40 ? 'bg-warning' : 'bg-success') %>"
                                    style="width: <%= cholScore %>%">
                                </div>
                            </div>
                        </div>

                        <div class="factor">
                            <div class="d-flex justify-content-between mb-1">
                                <span data-i18n="label_smoke">Smoking Status</span>
                                <small class="text-white-50"><%= smokeValue %></small>
                            </div>
                            <div class="progress">
                                <div class="progress-bar <%= smokeScore > 60 ? 'bg-danger' : (smokeScore > 30 ? 'bg-info' : 'bg-success') %>"
                                    style="width: <%= smokeScore %>%">
                                </div>
                            </div>
                        </div>

                        <div class="factor">
                            <div class="d-flex justify-content-between mb-1">
                                <span data-i18n="label_exang">Exercise Induced Angina</span>
                                <small class="text-white-50"><%= exangValue %></small>
                            </div>
                            <div class="progress">
                                <div class="progress-bar <%= exangScore > 60 ? 'bg-danger' : 'bg-success' %>"
                                    style="width: <%= exangScore %>%">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="glass-small h-100">
                        <h4 class="d-flex align-items-center gap-2">
                            <i class="bi bi-lightbulb-fill text-amber"></i>
                            <span data-i18n="res_recommendations_title">Clinical & Lifestyle Recommendations</span>
                        </h4>

                        <div class="recommend-card">
                            <i class="bi bi-heart-pulse-fill text-rose"></i>
                            <div>
                                <h6 data-i18n="rec1_title">Physical Activity</h6>
                                <p data-i18n="rec1_desc">Engage in moderate-intensity aerobic exercise (e.g. brisk walking) for at least 30 minutes daily, 5 days a week.</p>
                            </div>
                        </div>

                        <div class="recommend-card">
                            <i class="bi bi-egg-fried text-amber"></i>
                            <div>
                                <h6 data-i18n="rec2_title">Heart-Healthy Diet</h6>
                                <p data-i18n="rec2_desc">Adopt a Mediterranean-style diet low in saturated fats, sodium (&lt;2,300mg/day), and refined sugars.</p>
                            </div>
                        </div>

                        <div class="recommend-card">
                            <i class="bi bi-ban text-danger"></i>
                            <div>
                                <h6 data-i18n="rec3_title">Smoking & Alcohol Cessation</h6>
                                <p data-i18n="rec3_desc">Eliminate tobacco usage and limit alcohol consumption to minimize cardiovascular wall stress.</p>
                            </div>
                        </div>

                        <div class="recommend-card">
                            <i class="bi bi-hospital-fill text-cyan"></i>
                            <div>
                                <h6 data-i18n="rec4_title">Cardiologist Follow-up</h6>
                                <p data-i18n="rec4_desc">Follow up with a healthcare professional or cardiologist for diagnostic echocardiogram and lipid profile review.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons: Print/Export & New Prediction -->
            <div class="row mt-5 g-4 no-print-section">
                <div class="col-md-6">
                    <button type="button" class="btn btn-lg btn-primary w-100" id="btn-print-report" onclick="exportOrPrintReport()">
                        <i class="bi bi-printer"></i>
                        <span data-i18n="btn_print">Print / Save PDF Report</span>
                    </button>
                </div>

                <div class="col-md-6">
                    <a href="/" class="btn btn-lg btn-warning w-100">
                        <i class="bi bi-arrow-repeat"></i>
                        <span data-i18n="btn_predict_another">Predict Another Patient</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Footer -->
<footer class="footer">
    <div class="container">
        <div class="footer-simple text-center">
            <div class="footer-brand mb-2">
                <span class="brand-text fs-5 fw-bold">CardioPulse</span>
            </div>
            <p class="footer-desc mb-2 text-white-50 small" data-i18n="footer_subtitle">Next-Gen AI Cardiovascular Disease Risk Stratification System</p>
            <div class="footer-copyright text-white-50 small opacity-75">
                © 2026 CardioPulse • SHIVAM CHAUHAN
            </div>
        </div>
    </div>
</footer>

<!-- Hidden Risk Value for JavaScript Gauge Animation -->
<input type="hidden" id="risk-value" value="<%= risk %>">
<input type="hidden" id="patient-name-val" value="<%= name %>">

<!-- Bootstrap -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- html2pdf Library for 1-Click PDF Generation in Sandboxed Environments -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<!-- JavaScript -->
<script src="/static/js/script.js"></script>

</body>
</html>
